---
const certifications = [
  {
    title: 'Frontend Developer (Vue.js)',
    issuer: 'IT Step Academy',
    credential: 'CSY-015471',
    icon: 'code',
  },
  {
    title: 'Project Management Intern',
    issuer: 'Ekreative',
    credential: '',
    icon: 'pm',
  },
  {
    title: 'Project Management Essentials',
    issuer: 'IBM',
    credential: '',
    icon: 'ibm',
  },
];
---

<section
  id="education"
  class="border-b border-slate-200/60 bg-slate-50 py-16 sm:py-24"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <!-- Education Column -->
      <div>
        <div>
          <h2 class="text-xs font-bold tracking-wider text-blue-600 uppercase">
            Background
          </h2>
          <p
            class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"
          >
            Education
          </p>
        </div>

        <div class="mt-8 space-y-6">
          <div
            class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:border-blue-200 hover:shadow-md"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <span
                  class="inline-block rounded bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700"
                >
                  Master's Degree
                </span>
                <h3 class="mt-2 text-lg font-bold text-slate-900">
                  Master of Science in Computer Science
                </h3>
                <p class="text-sm font-semibold text-slate-600">
                  State Technological University
                </p>
              </div>
              <span
                class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium whitespace-nowrap text-slate-600"
              >
                Sep 2022 – Jan 2024
              </span>
            </div>

            <p
              class="mt-4 border-t border-slate-100 pt-3 text-sm leading-relaxed text-slate-600"
            >
              <strong class="font-medium text-slate-800"
                >Completed coursework in:</strong
              > Data Structures, Algorithms, Software Engineering, Databases, and
              Machine Learning.
            </p>
          </div>
        </div>
      </div>

      <!-- Certifications Column -->
      <div>
        <div>
          <h2 class="text-xs font-bold tracking-wider text-blue-600 uppercase">
            Qualifications
          </h2>
          <p
            class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"
          >
            Certifications
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {
            certifications.map((cert) => (
              <div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:border-blue-200 hover:shadow-md">
                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                    />
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-base font-bold text-slate-900">
                    {cert.title}
                  </h3>
                  <div class="mt-0.5 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                    <span class="font-medium text-blue-600">{cert.issuer}</span>
                    {cert.credential && (
                      <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-500">
                        Credential: {cert.credential}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
