---

---

<section
  id="about"
  class="relative overflow-hidden border-b border-slate-200/60 bg-white py-16 sm:py-24"
>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-semibold text-blue-700"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
            ></span>
          </span>
          Available for new opportunities &bull; Warsaw, Poland
        </div>

        <h1
          class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
        >
          Hi, I'm <span
            class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent"
            >Daria Malenko</span
          >
        </h1>
        <p class="mt-2 text-xl font-semibold text-blue-600 sm:text-2xl">
          Frontend & Full Stack Developer
        </p>

        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          Detail-oriented developer with extensive experience building
          high-performance Single Page Applications (SPAs) using <strong
            class="font-semibold text-slate-900"
            >Vue.js (Vue 3, Composition API, Nuxt, Pinia, Vuex)</strong
          >, <strong class="font-semibold text-slate-900">TypeScript</strong>,
          JavaScript (ES6+), and <strong class="font-semibold text-slate-900"
            >React.js</strong
          >. Actively leveraging <strong class="font-semibold text-slate-900"
            >AI tools & LLMs</strong
          > to accelerate feature delivery, automate workflows, and optimize code
          quality. Proven track record delivering enterprise-grade platforms featuring
          real-time messaging, role-based access control (RBAC), data visualization
          dashboards, and dynamic internationalization (RTL/bilingual support). Hands-on
          experience extending frontend architectures with PHP and domain setup administration.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="mailto:maridariama3@gmail.com"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-md shadow-blue-500/20 transition-all hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/30"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Contact Me
          </a>
          <a
            href="https://linkedin.com/in/daria-malenko"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-700 transition-all hover:border-slate-400 hover:bg-slate-50"
          >
            <svg
              class="h-5 w-5 fill-current text-[#0A66C2]"
              viewBox="0 0 24 24"
            >
              <path
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
              ></path>
            </svg>
            LinkedIn
          </a>
          <a
            href="https://github.com/dariama3"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-700 transition-all hover:border-slate-400 hover:bg-slate-50"
          >
            <svg
              class="h-5 w-5 fill-current text-slate-900"
              viewBox="0 0 24 24"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- Quick Info / Key Highlights Card -->
      <div class="lg:col-span-4">
        <div
          class="rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 to-blue-50/40 p-6 shadow-sm"
        >
          <h2 class="text-sm font-bold tracking-wider text-slate-500 uppercase">
            Quick Details
          </h2>
          <div class="mt-4 space-y-3.5 text-sm">
            <div class="flex items-start gap-3">
              <span class="rounded-lg bg-blue-100 p-2 text-blue-600">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Location</p>
                <p class="text-slate-600">Warsaw, Poland</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="rounded-lg bg-blue-100 p-2 text-blue-600">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Email</p>
                <a
                  href="mailto:maridariama3@gmail.com"
                  class="text-blue-600 hover:underline"
                  >maridariama3@gmail.com</a
                >
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="rounded-lg bg-blue-100 p-2 text-blue-600">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l9-5-9-5-9 5 9 5z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                  ></path>
                </svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Degree</p>
                <p class="text-slate-600">M.Sc. in Computer Science</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="rounded-lg bg-blue-100 p-2 text-blue-600">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
                  ></path>
                </svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Languages</p>
                <p class="text-slate-600">
                  English (Fluent), Ukrainian (Native), Russian (Native), Polish
                  (Basic), German (Basic)
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Background decorative blurs -->
  <div
    class="pointer-events-none absolute top-0 right-0 -mt-20 -mr-20 hidden lg:block"
    aria-hidden="true"
  >
    <div
      class="h-96 w-96 rounded-full bg-blue-100 opacity-40 mix-blend-multiply blur-3xl"
    >
    </div>
  </div>
  <div
    class="pointer-events-none absolute bottom-0 left-0 -mb-20 -ml-20 hidden lg:block"
    aria-hidden="true"
  >
    <div
      class="h-80 w-80 rounded-full bg-indigo-100 opacity-40 mix-blend-multiply blur-3xl"
    >
    </div>
  </div>
</section>
