---

<footer id="contact" class="bg-slate-900 text-slate-300">
  <!-- Contact / CTA section -->
  <div class="border-b border-slate-800 py-16">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-xs font-bold tracking-wider text-blue-400 uppercase">
        Let's Connect
      </h2>
      <p
        class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
      >
        Get In Touch
      </p>
      <p class="mx-auto mt-3 max-w-xl text-slate-400">
        Interested in collaborating, hiring, or discussing frontend & full stack
        development opportunities? Feel free to reach out!
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="mailto:maridariama3@gmail.com"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-500/25 transition-all hover:bg-blue-500 hover:shadow-blue-500/40"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          maridariama3@gmail.com
        </a>

        <a
          href="https://linkedin.com/in/daria-malenko"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/80 px-5 py-3.5 text-sm font-semibold text-slate-200 transition-all hover:border-slate-600 hover:bg-slate-800 hover:text-white"
        >
          <svg class="h-4 w-4 fill-current text-[#0A66C2]" viewBox="0 0 24 24">
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
            ></path>
          </svg>
          LinkedIn Profile
        </a>

        <a
          href="https://github.com/dariama3"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/80 px-5 py-3.5 text-sm font-semibold text-slate-200 transition-all hover:border-slate-600 hover:bg-slate-800 hover:text-white"
        >
          <svg class="h-4 w-4 fill-current text-slate-300" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          GitHub Profile
        </a>
      </div>
    </div>
  </div>

  <!-- GDPR Statement & Copyright -->
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div
      class="rounded-xl border border-slate-800 bg-slate-800/40 p-4 text-xs leading-relaxed text-slate-400"
    >
      <span class="font-semibold text-slate-300">GDPR Consent Statement:</span> I
      hereby give consent for my personal data included in the application to be processed
      for the purposes of the recruitment process in accordance with the Regulation
      (EU) 2016/679 of the European Parliament and of the Council of 27 April 2016
      (GDPR).
    </div>

    <div
      class="mt-6 flex flex-col items-center justify-between gap-4 text-xs text-slate-500 sm:flex-row"
    >
      <p>
        &copy; {new Date().getFullYear()} Daria Malenko. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href="#about" class="transition-colors hover:text-slate-400"
          >Back to top &uarr;</a
        >
      </div>
    </div>
  </div>
</footer>
