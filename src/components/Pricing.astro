---
const plans = [
  {
    title: 'Plan A',
    description: 'Free version with basic features',
    price: 'Free',
    icon: '1',
  },
  {
    title: 'Plan B',
    description: 'Best for individuals who need more flexibility and tools',
    price: '$19',
    icon: '2',
  },
  {
    title: 'Plan C',
    description:
      'Advanced plan with full access to all features and priority support',
    price: '$29',
    icon: '️3',
  },
];
---

<section id="pricing" class="bg-slate-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
        Choose the right plan for you
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
        Find the perfect plan that fits your needs and budget.
      </p>
    </div>

    <div class="mt-20 grid grid-cols-1 gap-12 md:grid-cols-3">
      {
        plans.map((plan) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-4 text-4xl">{plan.icon}</div>
            <h3 class="mb-2 text-xl font-semibold text-slate-900">
              {plan.title}
            </h3>
            <p class="leading-relaxed text-slate-600">{plan.description}</p>
            <p class="mt-6 flex items-end justify-center gap-2">
              <span class="text-3xl font-bold">{plan.price}</span>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
