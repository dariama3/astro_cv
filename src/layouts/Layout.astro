---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daria Malenko | Frontend & Full Stack Developer CV',
  description = 'Curriculum Vitae of Daria Malenko - Detail-oriented Frontend & Full Stack Developer specializing in Vue.js, TypeScript, React, and modern web technologies.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-blue-500 selection:text-white"
  >
    <slot />
  </body>
</html>
